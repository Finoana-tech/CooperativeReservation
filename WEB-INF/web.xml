<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
    http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">

    <display-name>Cooperative de Transport</display-name>
    <description>Application de gestion des réservations de places</description>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==================== SERVLETS ==================== -->
    
    <!-- Client Servlet -->
    <servlet>
        <servlet-name>ClientServlet</servlet-name>
        <servlet-class>controller.ClientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientServlet</servlet-name>
        <url-pattern>/client</url-pattern>
    </servlet-mapping>

    <!-- Reservation Servlet -->
    <servlet>
        <servlet-name>ReservationServlet</servlet-name>
        <servlet-class>controller.ReservationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReservationServlet</servlet-name>
        <url-pattern>/reservation</url-pattern>
    </servlet-mapping>

    <!-- Voiture Servlet -->
    <servlet>
        <servlet-name>VoitureServlet</servlet-name>
        <servlet-class>controller.VoitureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VoitureServlet</servlet-name>
        <url-pattern>/voiture</url-pattern>
    </servlet-mapping>

    <!-- Statistique Servlet -->
    <servlet>
        <servlet-name>StatistiqueServlet</servlet-name>
        <servlet-class>controller.StatistiqueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatistiqueServlet</servlet-name>
        <url-pattern>/statistique</url-pattern>
    </servlet-mapping>

    <!-- ==================== PAGES D'ERREUR ==================== -->
    
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>